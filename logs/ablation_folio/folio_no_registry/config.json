{
  "model_name": "gemma4:31b-cloud",
  "host": "https://ollama.com/api/chat",
  "auth": "environment_variable",
  "max_tokens": 12288,
  "timeout": 600,
  "mode": "hybrid",
  "ablation": "no_registry",
  "ablation_details": {
    "name": "no_registry",
    "description": "w/o Registry: No accumulated ontology state R_i between sentences (Demonstrates Predicate Drift & Symbol Inconsistency)",
    "enable_global_analysis": true,
    "enable_joint_proposal": true,
    "enable_blind_backtranslation": true,
    "enable_semantic_verification": true,
    "enable_semantic_repair": true,
    "enable_ast_validation": true,
    "enable_ast_repair": true,
    "enable_registry": false
  }
}